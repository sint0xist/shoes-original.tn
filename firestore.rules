rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // AUTH HELPERS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isPrimaryAdmin() {
      return isSignedIn()
        && request.auth.token.email == "amineadem@gmail.com";
    }

    function isAdmin() {
      return isSignedIn() && (
        isPrimaryAdmin() ||
        exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        )
      );
    }


    // ============================================================
    // ADMINS
    // ============================================================

    match /admins/{adminUid} {

      // Admin can read their own admin document.
      // Existing admins can also read admin documents.
      allow read: if isSignedIn() &&
        (request.auth.uid == adminUid || isAdmin());

      // Only the primary admin or an existing admin can
      // create/update/delete admin records.
      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // PRODUCTS
    // ============================================================

    match /products/{productId} {

      // Everyone can view products.
      allow read: if true;

      // Only admins can add/edit/delete products.
      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // CATEGORIES
    // ============================================================

    match /categories/{categoryId} {

      allow read: if true;

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // BRANDS
    // ============================================================

    match /brands/{brandId} {

      allow read: if true;

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // STORE SETTINGS
    // ============================================================

    match /settings/{settingId} {

      // Customers need to read store settings.
      allow read: if true;

      // Only admins can change settings.
      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // PROMOTIONS
    // ============================================================

    match /promotions/{promotionId} {

      allow read: if true;

      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // ORDERS
    // ============================================================

    match /orders/{orderId} {

      // Admin can view, modify and delete orders.
      allow read, update, delete: if isAdmin();

      // Customer checkout can create an order ONLY when the
      // required server-generated key and data validation pass.
      allow create: if
        request.resource.data.status == "Nouvelle"
        && request.resource.data.isRead == false
        && request.resource.data.serverKey ==
          "AMINO_SECURE_SERVER_KEY_V2_89f3a21e4b9017c6d5e12a"
        && request.resource.data.items is list
        && request.resource.data.customer is map
        && request.resource.data.customer.name is string
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.wilaya is string
        && request.resource.data.customer.delegation is string
        && request.resource.data.total is number;
    }


    // ============================================================
    // RETURNS
    // ============================================================

    match /returns/{returnId} {

      // Customers/public side can read only if your application
      // actually requires it. Otherwise change this to isAdmin().
      allow read: if true;

      // Only admins can create/edit/delete returns.
      allow create, update, delete: if isAdmin();
    }


    // ============================================================
    // MANUAL REVENUES
    // ============================================================

    match /manual_revenues/{revenueId} {

      // Financial information should NOT be public.
      allow read, create, update, delete: if isAdmin();
    }


    // ============================================================
    // DEFAULT DENY
    // ============================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
